# Local dictation (fork): send mic audio to the homelab whisper-svc instead
# of Deepgram. Without the engine switch the upstream cloud path stays active.
NEXT_PUBLIC_LH_STT_ENGINE=whisper

# Where app/api/stt/transcribe finds whisper-svc.
# whisper-svc binds 127.0.0.1 on .2 → keep scripts/whisper-tunnel.sh up,
# or point this at a host that can reach the service directly.
STT_BASE_URL=http://127.0.0.1:8280
